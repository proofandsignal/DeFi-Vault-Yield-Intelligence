# Runtime
PORT=8787
EVM_RPC_URL=https://ethereum-rpc.publicnode.com

# OPEN = comparison API available for development/validation.
# KEYED = /api/v1/compare requires a valid PRO/B2B API key.
DVY_API_ACCESS_MODE=OPEN

# Store SHA-256 hashes only, never raw production API keys.
# Example:
# DVY_API_KEY_HASHES_JSON={"<sha256-of-key>":"PRO","<sha256-of-key>":"B2B"}
DVY_API_KEY_HASHES_JSON={}
